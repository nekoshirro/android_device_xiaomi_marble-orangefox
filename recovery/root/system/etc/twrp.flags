# mount point   fstype  device                                          device2             flags
# Logical partitions
# Optional layout-specific logical partitions (/system_dlkm on 6.6 ROMs and
# /mi_ext on 5.10 MIUI/HyperOS ROMs) are defined solely in recovery.fstab with
# logical,slotselect,...,nofail so Prepare_Super_Volume maps them only when
# present in super without twrp.flags synthesizing unmapped phantom entries.
/system_image   emmc    /dev/block/mapper/system                                            flags=slotselect
/system_ext     ext4    system_ext                                                          flags=display="System EXT"
/vendor_dlkm    ext4    vendor_dlkm                                                         flags=display="Vendor DLKM"

# Boot and recovery partitions
/boot           emmc    /dev/block/bootdevice/by-name/boot                                  flags=slotselect
/cache          ext4    /dev/block/bootdevice/by-name/rescue                                flags=backup=0
/recovery       emmc    /dev/block/bootdevice/by-name/recovery                              flags=slotselect;display="Recovery";backup=1;flashimg=1
/vendor_boot    emmc    /dev/block/bootdevice/by-name/vendor_boot                           flags=slotselect;display="Vendor Boot";backup=1;flashimg=1
/frp            emmc    /dev/block/bootdevice/by-name/frp                                   flags=display="FRP";wipeingui

# AVB partitions
/dtbo           emmc    /dev/block/bootdevice/by-name/dtbo                                  flags=slotselect;display="DTBO";backup=1;flashimg=1
/vbmeta         emmc    /dev/block/bootdevice/by-name/vbmeta                                flags=slotselect;display="VBMeta";backup=1;flashimg=1
/vbmeta_system  emmc    /dev/block/bootdevice/by-name/vbmeta_system                         flags=slotselect;display="VBMeta System";backup=1;flashimg=1

# Persistent firmware and properties
/firmware       vfat    /dev/block/bootdevice/by-name/modem                                 flags=slotselect;display="Firmware";mounttodecrypt;fsflags="ro,shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337,context=u:object_r:firmware_file:s0"
/persist        ext4    /dev/block/bootdevice/by-name/persist                               flags=display="Persist";fsflags=rw
/persist_image  emmc    /dev/block/bootdevice/by-name/persist                               flags=display="Persist Image";backup=1;flashimg=1

# Modem partitions
/modem          emmc    /dev/block/bootdevice/by-name/modem                                 flags=slotselect;backup=1;flashimg=1;display="Modem"
/bluetooth      emmc    /dev/block/bootdevice/by-name/bluetooth                             flags=slotselect;backup=1;flashimg=1;display="Bluetooth"
/dsp            emmc    /dev/block/bootdevice/by-name/dsp                                   flags=slotselect;backup=1;flashimg=1;display="DSP"

# EFS partitions
/efs1           emmc    /dev/block/bootdevice/by-name/modemst1                              flags=backup=1;display="EFS"
/efs2           emmc    /dev/block/bootdevice/by-name/modemst2                              flags=backup=1;subpartitionof=/efs1
/efsc           emmc    /dev/block/bootdevice/by-name/fsc                                   flags=backup=1;subpartitionof=/efs1
/efsg           emmc    /dev/block/bootdevice/by-name/fsg                                   flags=backup=1;subpartitionof=/efs1

# Removable storage
/usb_otg        auto    /dev/block/sdg1                                 /dev/block/sdg      flags=display="USB-OTG";storage;wipeingui;removable;fsflags="utf8"
